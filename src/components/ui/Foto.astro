---
// Foto optimizada: WebP en anchos de 360 a 1440.
// Solo WebP: lo soportan todos los navegadores actuales y se genera mucho más rápido que AVIF,
// así el build entra holgado en el tiempo de Cloudflare.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ANCHOS } from '../../lib/fotos';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  sizes: string;
  proporcion?: '32' | '43' | 'libre';
  prioridad?: boolean;       // la foto LCP: carga inmediata y fetchpriority alto
  inmediata?: boolean;       // carga inmediata sin prioridad (las dos primeras de la grilla)
  transicion?: string;       // view-transition-name
  anchos?: number[];
  class?: string;
}
const { src, alt, sizes, proporcion = '32', prioridad = false, inmediata = false, transicion, anchos = ANCHOS, class: clase } = Astro.props;
const comunes = {
  alt,
  format: 'webp' as const,
  widths: anchos,
  sizes,
  quality: proporcion === '43' && prioridad ? 64 : 70,
  loading: prioridad || inmediata ? ('eager' as const) : ('lazy' as const),
  decoding: prioridad ? ('sync' as const) : ('async' as const),
  fetchpriority: prioridad ? ('high' as const) : undefined,
  class: ['foto', `foto-${proporcion}`, clase].filter(Boolean).join(' '),
  style: transicion ? `view-transition-name:${transicion}` : undefined,
};
---
{typeof src === 'string' ? <Image src={src} inferSize {...comunes} /> : <Image src={src} {...comunes} />}
