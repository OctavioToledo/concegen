---
// Tarjeta del stock: foto limpia, la condición, el nombre, los datos en una línea, el precio y dos acciones.
import type { Auto } from '../../schema/auto';
import Foto from '../ui/Foto.astro';
import Icono from '../ui/Icono.astro';
import { fotoAuto, SIZES } from '../../lib/fotos';
import { combustibles, nombre, slugTexto, transmisiones } from '../../lib/etiquetas';
import { precioComparable } from '../../lib/stock';
import { agencia, absoluta } from '../../lib/agencia';
import { whatsappUrl, mensajeFicha } from '../../lib/whatsapp';
import { km, precio } from '../../lib/formato';

interface Props {
  auto: Auto;
  inmediata?: boolean;       // las primeras de la grilla
  prioridad?: boolean;       // la primera del stock: es el LCP
  datos?: boolean;           // atributos data-* para filtrar en /stock
  orden?: number;            // posición en Recomendados
  sizes?: string;
  encabezado?: 'h2' | 'h3';
}
const { auto, inmediata = false, prioridad = false, datos = false, orden, sizes = SIZES.tarjeta, encabezado = 'h3' } = Astro.props;
const portada = auto.fotos[0];
const Titulo = encabezado;
const href = `/autos/${auto.slug}`;
const vendido = auto.estado === 'vendido';
const reservado = auto.estado === 'reservado';
const condicion = vendido ? 'Vendido' : reservado ? 'Reservado' : auto.condicion === '0km' ? '0 km' : 'Usado';
const wa = whatsappUrl(agencia.contacto.whatsapp, mensajeFicha(auto, absoluta(href), vendido ? 'similar' : 'consulta'));
const atributos = datos
  ? {
      'data-auto': '',
      'data-marca': slugTexto(auto.marca),
      'data-modelo': slugTexto(auto.modelo),
      'data-anio': auto.anio,
      'data-precio': precioComparable(auto) ?? '',
      'data-km': auto.km,
      'data-comb': auto.combustible,
      'data-caja': auto.transmision,
      'data-carr': auto.carroceria,
      'data-cond': auto.condicion,
      'data-estado': auto.estado,
      'data-ingreso': auto.fechaIngreso,
      'data-rec': orden,
    }
  : {};
---
<article class:list={['tarjeta', vendido && 'es-vendido']} {...atributos}>
  <a class="tarjeta-foto" href={href} tabindex="-1" aria-label={`${nombre(auto)}, ver detalle`}>
    <Foto src={fotoAuto(portada.src)!} alt="" sizes={sizes} inmediata={inmediata} prioridad={prioridad} transicion={datos ? `foto-${auto.slug}` : undefined} />
  </a>
  <div class="tarjeta-cuerpo">
    <p class:list={['tarjeta-condicion', 'tag', `tag--${vendido ? 'vendido' : reservado ? 'reservado' : auto.condicion}`]}>{condicion}</p>
    <Titulo class="tarjeta-nombre"><a href={href}>{nombre(auto)}<span class="sr">, {condicion.toLowerCase()}</span></a></Titulo>
    <p class="tarjeta-version">{auto.version}</p>
    <ul class="specs" aria-label="Datos">
      <li><Icono nombre="calendario" />{auto.anio}</li>
      <li><Icono nombre="ruta" />{auto.condicion === '0km' ? '0 km' : km(auto.km)}</li>
      <li><Icono nombre="caja" />{transmisiones[auto.transmision]}</li>
      <li><Icono nombre="combustible" />{combustibles[auto.combustible]}</li>
    </ul>
    <div class="tarjeta-pie">
      <p class="tarjeta-precio">
        {vendido
          ? <span class="tarjeta-precio-nota">Ya se vendió</span>
          : auto.precio === null
            ? <span class="tarjeta-precio-nota">Consultar precio</span>
            : precio(auto.precio, auto.moneda)}
      </p>
      <div class="tarjeta-acciones">
        <a class="flecha" href={href}>Ver detalle<span class="sr">: {nombre(auto)}</span></a>
        <a class="wa wa-icono" href={wa} target="_blank" rel="noopener" aria-label={`Consultar por WhatsApp: ${nombre(auto)}`}
           data-wa-origen="tarjeta" data-wa-motivo={vendido ? 'similar' : 'consulta'} data-wa-auto={auto.slug}>
          <Icono nombre="whatsapp" />
        </a>
      </div>
    </div>
  </div>
</article>
