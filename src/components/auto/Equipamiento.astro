---
import Icono from '../ui/Icono.astro';

interface Props { items: string[] }
const { items } = Astro.props;
---
{items.length > 0 && (
  <section aria-labelledby="equip-titulo" class="pila">
    <h2 id="equip-titulo">Equipamiento</h2>
    <ul class="equipamiento">
      {items.map((i) => <li><Icono nombre="check" />{i}</li>)}
    </ul>
  </section>
)}
