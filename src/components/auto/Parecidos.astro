---
import type { Auto } from '../../schema/auto';
import TarjetaAuto from './TarjetaAuto.astro';
import { SIZES } from '../../lib/fotos';

interface Props { autos: Auto[]; titulo?: string }
const { autos, titulo = 'Autos parecidos' } = Astro.props;
---
{autos.length > 0 && (
  <section aria-labelledby="parecidos-titulo">
    <div class="titulo-seccion">
      <h2 id="parecidos-titulo">{titulo}</h2>
    </div>
    <div class="carrusel">
      {autos.map((a) => <TarjetaAuto auto={a} sizes={SIZES.carrusel} />)}
    </div>
    <p class="centrado"><a class="flecha" href="/stock">Ver todo el stock</a></p>
  </section>
)}
