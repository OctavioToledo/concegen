---
import type { Auto } from '../../schema/auto';
import { numero } from '../../lib/formato';
import { combustibles, transmisiones } from '../../lib/etiquetas';
import Icono from '../ui/Icono.astro';

interface Props { auto: Auto }
const { auto } = Astro.props;
const datos = [
  ['calendario', 'Año', String(auto.anio)],
  ['ruta', 'Kilómetros', numero(auto.km)],
  ['combustible', 'Combustible', combustibles[auto.combustible]],
  ['caja', 'Caja', transmisiones[auto.transmision]],
] as const;
---
<dl class="datos">
  {datos.map(([icono, rotulo, valor]) => (
    <div class="dato">
      <Icono nombre={icono} />
      <dt>{rotulo}</dt>
      <dd>{valor}</dd>
    </div>
  ))}
</dl>
