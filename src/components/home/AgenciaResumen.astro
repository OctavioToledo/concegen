---
// Dirección, horario y mapa en una banda gris. El mapa embebido carga solo si el usuario lo toca.
import { agencia } from '../../lib/agencia';
import { whatsappUrl } from '../../lib/whatsapp';
import { mensajes } from '../../config/mensajes';
import Horario from '../sitio/Horario.astro';
import Mapa from '../sitio/Mapa.astro';

const href = whatsappUrl(agencia.contacto.whatsapp, mensajes.general({ agencia: agencia.nombre }));
---
<section class="banda seccion" aria-labelledby="agencia-titulo">
  <div class="contenedor visita">
    <div class="pila">
      <h2 id="agencia-titulo">Visitanos en {agencia.ciudad.split(',')[0]}</h2>
      <p>{agencia.contacto.direccion}</p>
      <Horario />
      <p class="pila-chica">
        <a class="flecha" href={href} target="_blank" rel="noopener" data-wa-origen="contacto">Escribinos por WhatsApp</a><br />
        <a class="flecha" href={agencia.contacto.mapsUrl} target="_blank" rel="noopener">Cómo llegar</a>
      </p>
    </div>
    <Mapa />
  </div>
</section>
