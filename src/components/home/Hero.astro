---
// Portada: la foto a sangre, sin nada encima. El nombre, el precio y los links van debajo, centrados.
// Sin JavaScript se desliza con el dedo (scroll-snap); con JavaScript suma flechas, puntos y avance automático con pausa.
import { agencia, absoluta } from '../../lib/agencia';
import { autoHero, destacados } from '../../lib/stock';
import { fotoAuto, fotoAgencia } from '../../lib/fotos';
import { nombre } from '../../lib/etiquetas';
import { precio } from '../../lib/formato';
import { whatsappUrl, mensajeFicha } from '../../lib/whatsapp';
import Foto from '../ui/Foto.astro';
import Icono from '../ui/Icono.astro';

const primero = autoHero();
const slides = primero ? [primero, ...destacados().filter((a) => a.id !== primero.id)].slice(0, 4) : [];
const fotoLocal = agencia.hero.tipo === 'foto' ? fotoAgencia(agencia.hero.src) : undefined;
const SIZES = '100vw';
---
{slides.length > 0 ? (
  <section class="portada" aria-roledescription="carrusel" aria-label="Autos destacados" data-slider>
    <div class="portada-pista" data-pista>
      {slides.map((a, i) => (
        <article class="slide" aria-roledescription="diapositiva" aria-label={`${i + 1} de ${slides.length}: ${nombre(a)}`} id={`slide-${i}`}>
          <a href={`/autos/${a.slug}`} class="slide-imagen" tabindex="-1" aria-label={`${nombre(a)}, ver esta unidad`}>
            <Foto src={fotoAuto(a.fotos[0].src)!} alt="" sizes={SIZES} proporcion="libre" prioridad={i === 0} anchos={[480, 768, 1080, 1440, 1920]} class="slide-foto" />
          </a>
          <div class="slide-texto contenedor">
            <p class:list={['tag', `tag--${a.condicion}`]}>{a.condicion === '0km' ? '0 km' : `Usado, ${a.anio}`}</p>
            <h2 class="slide-nombre">{nombre(a)}</h2>
            <p class="slide-version">
              {a.version}
              {a.precio !== null && <span class="slide-precio">{precio(a.precio, a.moneda)}</span>}
            </p>
            <p class="slide-links">
              <a class="flecha" href={`/autos/${a.slug}`}>Ver esta unidad<span class="sr">: {nombre(a)}</span></a>
              <a class="flecha" href={whatsappUrl(agencia.contacto.whatsapp, mensajeFicha(a, absoluta(`/autos/${a.slug}`), 'consulta'))}
                 target="_blank" rel="noopener" data-wa-origen="portada" data-wa-motivo="consulta" data-wa-auto={a.slug}>Consultar por WhatsApp</a>
            </p>
          </div>
        </article>
      ))}
    </div>
    {slides.length > 1 && (
      <div class="portada-controles contenedor">
        <button type="button" data-ant aria-label="Anterior"><Icono nombre="anterior" /></button>
        <div class="portada-puntos" role="group" aria-label="Elegir diapositiva">
          {slides.map((a, i) => (
            <button type="button" data-ir={i} aria-label={`Ver ${nombre(a)}`} aria-current={i === 0 ? 'true' : 'false'} aria-controls={`slide-${i}`}></button>
          ))}
        </div>
        <button type="button" data-sig aria-label="Siguiente"><Icono nombre="siguiente" /></button>
        <button type="button" data-pausa aria-label="Pausar el avance automático" hidden><Icono nombre="pausa" /></button>
      </div>
    )}
  </section>
) : fotoLocal && agencia.hero.tipo === 'foto' ? (
  <section class="portada" aria-label={agencia.nombre}>
    <Foto src={fotoLocal} alt={agencia.hero.alt} sizes={SIZES} proporcion="libre" prioridad class="slide-foto" />
  </section>
) : null}

<script>
  import { iniciarSlider } from '../../scripts/slider';
  iniciarSlider();
</script>
