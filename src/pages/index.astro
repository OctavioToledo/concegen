---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Destacados from '../components/home/Destacados.astro';
import PorTipo from '../components/home/PorTipo.astro';
import Servicios from '../components/home/Servicios.astro';
import AgenciaResumen from '../components/home/AgenciaResumen.astro';
import Testimonios from '../components/home/Testimonios.astro';
import { agencia } from '../lib/agencia';
import { todos } from '../lib/stock';

const cantidad = todos().filter((a) => a.estado !== 'vendido').length;
---
<Base
  titulo={`${agencia.nombre}, autos 0 km y usados en ${agencia.ciudad}`}
  tituloCompleto
  descripcion={`${cantidad} autos 0 km y usados en ${agencia.ciudad}. Consultá cualquier unidad por WhatsApp.`}
>
  <Hero />
  <Destacados />
  <PorTipo />
  <Servicios />
  <Testimonios />
  <AgenciaResumen />
</Base>
